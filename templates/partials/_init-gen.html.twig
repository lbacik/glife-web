<div class="flex flex-row justify-center mt-12">
    <div class="basis-3/4">
        <form
                method="GET"
                {{ stimulus_controller("autosubmit", {
                    initData: config.initData,
                }) }}
        >
            <div class="flex flex-row">
                <label class="block text-sm font-medium text-gray-700 dark:text-white">
                    x
                    <input
                            type="number"
                            name="width"
                            value="{{ config.initX }}"
                            data-action="autosubmit#debouncedDispatchInitGrid"
                            class="{{ inputClass }}"
                            data-glife-target="initGridX"
                    />
                </label>
                <label class="block text-sm font-medium text-gray-700 dark:text-white ml-5">
                    y
                    <input
                            type="number"
                            name="height"
                            value="{{ config.initY }}"
                            data-action="autosubmit#debouncedDispatchInitGrid"
                            class="{{ inputClass }}"
                            data-glife-target="initGridY"
                    />
                </label>
                <label class="block text-sm font-medium text-gray-700 dark:text-white ml-5">
                    Width
                    <input
                            type="number"
                            name="cellSize"
                            value="{{ config.initWidth }}"
                            data-action="autosubmit#debouncedDispatchInitGrid"
                            class="{{ inputClass }}"
                            data-glife-target="initGridWidth"
                    />
                </label>
            </div>
            <div class="flex flex-row mt-4">
                <div class="block text-sm font-medium text-gray-700 dark:text-white w-full">
                    <div class="flex items-center justify-between">
                        <label for="init-gen">Initial generation</label>
                        <span>
                            <input type="file"
                                   class="hidden"
                                   data-autosubmit-target="initGridDataFile"
                                   data-action="change->autosubmit#loadFromFile"
                            />
                            <button type="button"
                                    class="ml-5 mr-2 bg-gray-100 hover:bg-blue-500 hover:text-white py-2 px-4 rounded mb-1"
                                    data-action="click->autosubmit#openFilePicker"
                            >Load from file</button>
                        </span>
                    </div>
                    <textarea class="{{ inputClass }}"
                              id="init-gen"
                              name="init-gen"
                              data-action="input->autosubmit#debouncedDispatchInitGridData"
                              data-autosubmit-target="initGridData"
                              data-glife-target="initGridData"
                    >{{ config.initData }}</textarea>
                </div>
            </div>
            <div class="flex flex-row mt-4">
                <div class="basis-1/2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-white">
                        <input
                                type="checkbox"
                                name="show-grid"
                                data-action="glife#toggleInitGrid"
                                data-glife-target="initGridCheckbox"
                        /> show on grid
                    </label>
                </div>
                <div class="basis-1/2 text-right">
                    <button
                            type="button"
                            class="ml-5 mr-2 bg-gray-100 hover:bg-blue-500 hover:text-white py-2 px-4 rounded mb-1"
                            data-action="glife#initGridApply"
                    >Apply</button>
                </div>
            </div>
        </form>
    </div>
</div>
